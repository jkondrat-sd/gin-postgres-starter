APP_NAME=example-gin
APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=example_gin
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
